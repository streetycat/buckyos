      "match_source": "origin_model_id",
      "pricing": {
        "unit": "image",
        "amount": 0.042,
        "rules": [
          { "when": { "all": [{ "path": "/quality", "op": "equals", "value": "high" }, { "path": "/size", "op": "in", "value": ["1024x1536", "1536x1024"] }] }, "amount": 0.25 },
          { "when": { "all": [{ "path": "/quality", "op": "equals", "value": "medium" }, { "path": "/size", "op": "in", "value": ["1024x1536", "1536x1024"] }] }, "amount": 0.063 },
          { "when": { "all": [{ "path": "/quality", "op": "equals", "value": "low" }, { "path": "/size", "op": "in", "value": ["1024x1536", "1536x1024"] }] }, "amount": 0.016 },
          { "when": { "path": "/quality", "op": "equals", "value": "high" }, "amount": 0.167 },
          { "when": { "path": "/quality", "op": "equals", "value": "low" }, "amount": 0.011 },
          { "when": { "path": "/size", "op": "in", "value": ["1024x1536", "1536x1024"] }, "amount": 0.063 }
        ]
      }
    },
    { "pattern": "gpt-image-2*", "match_source": "origin_model_id", "request_rules": [{ "remove": ["/input_fidelity"] }] },
    { "pattern": "dall-e-2*", "match_source": "origin_model_id", "pricing": { "unit": "image", "amount": 0.02 } },
    { "pattern": "dall-e-3*", "match_source": "origin_model_id", "pricing": { "unit": "image", "amount": 0.04, "rules": [{ "when": { "path": "/quality", "op": "equals", "value": "hd" }, "amount": 0.08 }] } }
